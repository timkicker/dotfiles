// -*- mode: jsonc -*-
{
    "height": 30,
    "spacing": 4,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "sway/window"
    ],
    "modules-center": [],
    "modules-right": [
        "mpris",
        "group/toggles",
        "custom/fan",
        "group/hardware",
        "backlight",
        "pulseaudio",
        "custom/peripherals",
        "custom/bluetooth",
        "network",
        "custom/updates",
        "disk",
        "power-profiles-daemon",
        "battery",
        "sway/language",
        "custom/weather",
        "clock",
        "tray",
        "custom/power"
    ],

    // ---------- left ----------
    "sway/window": {
        "max-length": 30,
        "rewrite": {
            ".* — Zen Browser": "Zen",
            ".* — Mozilla Firefox": "Firefox",
            ".* - Google Chrome": "Chrome",
            ".* - Chromium": "Chromium",
            "(.*)": "$1"
        }
    },
    "sway/mode": { "format": "<span style=\"italic\">{}</span>" },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    // ---------- toggles cluster ----------
    "group/toggles": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "custom/lid-inhibit", "custom/notification"]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Idle blockiert (Bildschirm bleibt an)",
        "tooltip-format-deactivated": "Idle normal"
    },
    "custom/lid-inhibit": {
        "return-type": "json",
        "exec": "~/.config/waybar/lid-inhibit.sh --status",
        "on-click": "~/.config/waybar/lid-inhibit.sh --toggle",
        "signal": 8,
        "interval": "once",
        "tooltip": true
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "", "none": "",
            "dnd-notification": "", "dnd-none": "",
            "inhibited-notification": "", "inhibited-none": "",
            "dnd-inhibited-notification": "", "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "on-click-middle": "swaync-client -C -sw",
        "escape": true
    },

    // ---------- fan (fw-fanctrl) ----------
    "custom/fan": {
        "exec": "~/.config/waybar/fan.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/fan.sh cycle",
        "signal": 9,
        "tooltip": true
    },

    // ---------- hardware drawer ----------
    "group/hardware": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 250, "children-class": "hw", "transition-left-to-right": false },
        "modules": ["temperature", "cpu", "memory"]
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 5,
        "tooltip-format": "CPU: {usage}%",
        "states": { "warning": 70, "critical": 90 }
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f}/{total:0.1f} GiB ({percentage}%)",
        "states": { "warning": 75, "critical": 92 }
    },
    "temperature": {
        "critical-threshold": 82,
        "interval": 5,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "tooltip-format": "Temperatur: {temperatureC}°C"
    },

    // ---------- io / status ----------
    "backlight": {
        "format": "\uf185 {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "headphone": "", "hands-free": "", "headset": "",
            "phone": "", "portable": "", "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/peripherals": {
        "exec": "~/.config/waybar/periph.sh",
        "return-type": "json",
        "interval": 120,
        "tooltip": true
    },
    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "",
        "format-linked": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-disconnected": "Keine Verbindung",
        "on-click": "nm-connection-editor"
    },
    "custom/bluetooth": {
        "exec": "~/.config/waybar/bt.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "kitty -e bluetoothctl",
        "tooltip": true
    },
    "custom/updates": {
        "exec": "~/.config/waybar/updates.sh",
        "return-type": "json",
        "interval": 3600,
        "on-click": "kitty -e sh -c 'yay -Syu; echo; read -n1 -p \"[Enter]\"'",
        "tooltip": true
    },
    "disk": {
        "interval": 60,
        "path": "/",
        "format": " {percentage_free}%",
        "tooltip-format": "{free} frei von {total} ({percentage_used}% belegt)",
        "states": { "warning": 85, "critical": 95 }
    },

    // ---------- power ----------
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Power-Profil: {profile}\nTreiber: {driver}",
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },

    // ---------- info ----------
    "sway/language": { "format": "{short}", "tooltip": false },
    "custom/weather": {
        "exec": "~/.config/waybar/weather.sh",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%a %Y-%m-%d}"
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "dynamic-len": 28,
        "dynamic-order": ["title", "artist"],
        "player-icons": { "default": "▶", "mpv": "", "firefox": "", "spotify": "" },
        "status-icons": { "paused": "⏸" },
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "tooltip": true
    },
    "tray": { "spacing": 10 },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/power.sh"
    }
}
